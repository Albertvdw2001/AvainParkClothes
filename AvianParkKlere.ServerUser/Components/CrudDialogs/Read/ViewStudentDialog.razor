@using AvianParkKlere.ServerUser.Services
@inject MudBlazor.ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ApiService _apiService  
@inject IJSRuntime _js

<MudDialog>
    <TitleContent>@Student.Name @Student.Surname (Gr. @Student.Grade)</TitleContent>

    <DialogContent>
        <MudTable Items="@ClothesList" Striped="true" Bordered="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Size</MudTh>
                <MudTh>Price</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Type">@context.Name</MudTd>
                <MudTd DataLabel="Size">@context.Size</MudTd>
                <MudTd DataLabel="Price">R @context.Price</MudTd>
            </RowTemplate>
        </MudTable>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@(async () => await DownloadPdf(ClothesList, $"{Student.Name}_{Student.Surname}Clothes"))">
            Download as PDF
        </MudButton>
    </DialogActions>
</MudDialog>