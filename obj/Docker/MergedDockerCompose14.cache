name: dockercompose11623690068333969154
services:
  avainparkklere.api:
    build:
      context: C:\Users\DELL\OneDrive\Desktop\apk\AvainParkClothes
      dockerfile: AvainParkKlere.Api/Dockerfile
    depends_on:
      sqlserver:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_URLS: http://localhost:5000:8080
    image: avainparkklereapi
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "5000"
        protocol: tcp
      - mode: ingress
        target: 8081
        published: "5001"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\DELL\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\DELL\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
  avianparkklere.serveruser:
    build:
      context: C:\Users\DELL\OneDrive\Desktop\apk\AvainParkClothes
      dockerfile: AvianParkKlere.ServerUser/Dockerfile
    depends_on:
      sqlserver:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8083"
      ASPNETCORE_URLS: http://localhost:5010:8080
    image: avianparkklereserveruser
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8083
        published: "5010"
        protocol: tcp
      - mode: ingress
        target: 8084
        published: "5011"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\DELL\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\DELL\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
  sqlserver:
    environment:
      SA_PASSWORD: Odegaard.8
    image: mcr.microsoft.com/mssql/server:2019-latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 1433
        published: "1433"
        protocol: tcp
networks:
  default:
    name: dockercompose11623690068333969154_default